-+    worker.postMessage({ canvas1: offscreen1 }, [offscreen1]);
-+    worker.postMessage({ canvas2: offscreen2 }, [offscreen2]);
-+
-+    const response_promise = new Promise(resolve => {
-+      worker.onmessage = t.step_func(msg => {
