diff --git a/v8/src/objects/string.tq b/v8/src/objects/string.tq
index 0165da42e98..f7cb50a778a 100644
--- a/v8/src/objects/string.tq
+++ b/v8/src/objects/string.tq
@@ -325,6 +325,11 @@ macro StringToSlice(string: String): never labels OneByte(ConstSlice<char8>),
 // Dispatch on the slice type of two different strings.
 macro TwoStringsToSlices<Result: type, Functor: type>(
     s1: String, s2: String, f: Functor): Result {
+  // Flatten both strings before taking either slice. A slice into an external
+  // string is a raw pointer that doesn't keep the string alive, so flattening
+  // s2 while holding s1's slice could collect s1 and free its resource.
+  const s1 = Flatten(s1);
+  const s2 = Flatten(s2);
   try {
     StringToSlice(s1) otherwise FirstOneByte, FirstTwoByte;
   } label FirstOneByte(s1Slice: ConstSlice<char8>) {
