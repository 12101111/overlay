    |
@@ -176,7 +173,6 @@ LL |         let V = Vec::new() else { return; };
    |             ^ constant of non-structural type
    |
   --> $SRC_DIR/alloc/src/vec/mod.rs:LL:COL
-  ::: $SRC_DIR/alloc/src/vec/mod.rs:LL:COL
