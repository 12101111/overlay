-  set(USE_HTTPS "OpenSSL" CACHE STRING "" FORCE)
-endif()
-# Force libgit2 to use the SAME CRT as the consuming app (/MD or /MDd) to avoid
-# D9025 warnings AND ABI mismatch between libgit2 (release CRT) and the rest of
