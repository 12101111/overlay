 #define VXCORE_SYNC_GIT_GIT_HANDLES_H
 
 #include <git2.h>
+// libgit2 >= 1.8 moved git_error_clear() out of <git2/errors.h> into the
+// "advanced" <git2/sys/errors.h>; older versions (e.g. the bundled 1.7.x)
+// declare it in <git2/errors.h> and ship no sys/errors.h at all. Pull in the
+// sys header when it exists so git_error_clear() resolves against either.
+#if defined(__has_include)
+#  if __has_include(<git2/sys/errors.h>)
+#    include <git2/sys/errors.h>
+#  endif
+#endif
 
 #include <memory>
 
