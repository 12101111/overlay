Make the Typst editor and its Rust helper optional.
--- a/libs/CMakeLists.txt
+++ b/libs/CMakeLists.txt
@@ -24,7 +24,9 @@
 # set(CMAKE_MSVC_RUNTIME_LIBRARY ... FORCE) (libs/vxcore/third_party/CMakeLists.txt)
 # ahead of vtextedit's configure, applying it to syntax-highlighting, katevi,
 # sonnet, hunspell and VTextEdit. Do not reorder.
-set(VTEXTEDIT_ENABLE_TYPST ON CACHE BOOL "Build the required native Typst editor" FORCE)
+if(NOT DEFINED VTEXTEDIT_ENABLE_TYPST)
+    set(VTEXTEDIT_ENABLE_TYPST ON CACHE BOOL "Build the required native Typst editor")
+endif()
 set(VTEXTEDIT_BUILD_DEMOS OFF CACHE BOOL "Disable vtextedit demo applications" FORCE)
 add_subdirectory(vtextedit)
 
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -69,14 +69,16 @@
 
 # Always refresh runtime dependencies, including builds that do not relink vnote.
 add_custom_target(vnote_typst_runtime)
-add_dependencies(vnote_typst_runtime vtextedit-typst)
-get_target_property(VX_TYPST_HELPER vtextedit-typst VTEXTEDIT_TYPST_HELPER)
-add_custom_command(TARGET vnote_typst_runtime
-    COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:vnote>"
-    COMMAND ${CMAKE_COMMAND} -E copy_if_different
-        "${VX_TYPST_HELPER}" "$<TARGET_FILE_DIR:vnote>"
-    VERBATIM
-)
+if(TARGET vtextedit-typst)
+    add_dependencies(vnote_typst_runtime vtextedit-typst)
+    get_target_property(VX_TYPST_HELPER vtextedit-typst VTEXTEDIT_TYPST_HELPER)
+    add_custom_command(TARGET vnote_typst_runtime
+        COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:vnote>"
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            "${VX_TYPST_HELPER}" "$<TARGET_FILE_DIR:vnote>"
+        VERBATIM
+    )
+endif()
 if(WIN32)
     add_dependencies(vnote_typst_runtime VTextEdit)
     add_custom_command(TARGET vnote_typst_runtime
