--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -24,6 +24,12 @@ set(CMAKE_AUTORCC OFF)
 
 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
 
+# WebDAV uses the system libcurl and pugixml instead of vendored copies. They
+# are looked up in the top-level directory so the imported targets are visible
+# to every subdirectory (imported targets are directory-scoped).
+find_package(CURL 7.64 REQUIRED)
+find_package(pugixml REQUIRED CONFIG)
+
 find_package(Threads REQUIRED)
 
 # OpenSSL is only required on Linux; Windows uses WinHTTP and macOS uses SecureTransport.
@@ -81,15 +87,6 @@ if(VXCORE_INSTALL)
