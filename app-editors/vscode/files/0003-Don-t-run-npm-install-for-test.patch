From 21fbb31812480ae772d0901a65b8d773d081a949 Mon Sep 17 00:00:00 2001
From: 12101111 <w12101111@gmail.com>
Date: Sat, 17 Oct 2026 22:30:44 +0800
Subject: [PATCH 03/15] Don't run npm install for test

---
 build/npm/dirs.ts        | 10 ----------
 build/npm/postinstall.ts |  5 -----
 2 files changed, 15 deletions(-)

diff --git a/build/npm/dirs.ts b/build/npm/dirs.ts
index 7bc33635f86..d4e3fffaaaa 100644
--- a/build/npm/dirs.ts
+++ b/build/npm/dirs.ts
@@ -55,16 +55,6 @@ export const dirs = [
 	'extensions/vscode-test-resolver',
 	'remote',
 	'remote/web',
-	'test/automation',
-	'test/integration/browser',
-	'test/monaco',
-	'test/smoke',
-	'test/scenario',
-	'test/mcp',
-	'.vscode/extensions/vscode-selfhost-import-aid',
-	'.vscode/extensions/vscode-selfhost-test-provider',
-	'.vscode/extensions/vscode-extras',
-	'.vscode/extensions/vscode-pr-pinger',
 ];
 
 if (existsSync(`${import.meta.dirname}/../../.build/distro/npm`)) {
diff --git a/build/npm/postinstall.ts b/build/npm/postinstall.ts
index 6405a015318..3509f81b432 100644
--- a/build/npm/postinstall.ts
+++ b/build/npm/postinstall.ts
@@ -245,8 +245,6 @@ async function main() {
 	if (!process.env['VSCODE_FORCE_INSTALL'] && isUpToDate()) {
 		finishCloudSandbox();
 		log('.', 'All dependencies up to date, skipping postinstall.');
-		child_process.execSync('git config pull.rebase merges');
-		child_process.execSync('git config blame.ignoreRevsFile .git-blame-ignore-revs');
 		return;
 	}
 
@@ -318,9 +316,6 @@ async function main() {
 	log('.', `Running ${parallelTasks.length} npm installs with concurrency ${concurrency}...`);
 	await runWithConcurrency(parallelTasks, concurrency);
 
-	child_process.execSync('git config pull.rebase merges');
-	child_process.execSync('git config blame.ignoreRevsFile .git-blame-ignore-revs');
-
 	finishCloudSandbox();
 
 	fs.writeFileSync(stateFile, JSON.stringify(_state));
-- 
