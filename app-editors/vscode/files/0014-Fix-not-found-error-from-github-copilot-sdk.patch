From 4a1eaaf9b3557e420a5c85fd051787079ee8a047 Mon Sep 17 00:00:00 2001
From: 12101111 <w12101111@gmail.com>
Date: Sat, 26 Sep 2026 18:00:08 +0800
Subject: [PATCH 14/15] Fix not found error from @github/copilot/sdk

---
 build/lib/extensions.ts | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/build/lib/extensions.ts b/build/lib/extensions.ts
index 10bd9fbd693..e5310b797df 100644
--- a/build/lib/extensions.ts
+++ b/build/lib/extensions.ts
@@ -479,10 +479,20 @@ export function packageCopilotExtensionStream(): Stream {
 	const productionDependencies = getProductionDependencies('extensions/copilot');
 	const dependenciesSrc = productionDependencies.map(d => path.relative(root, d)).map(d => [`${d}/**`, `!${d}/**/{test,tests}/**`]).flat();
 
+	// .moduleignore strips @github/copilot/** from every node_modules, which would
+	// also remove the extension's own copy of the Copilot CLI SDK required by
+	// prepareBuiltInCopilotRipgrepShim. Derive a rule set that keeps the package
+	// but drops the standalone CLI binaries the in-process SDK does not use.
+	const copilotModuleIgnorePath = path.join(root, 'build', '.moduleignore.copilot-extension');
+	fs.writeFileSync(copilotModuleIgnorePath, fs.readFileSync(path.join(root, 'build', '.moduleignore'), 'utf8')
+		.split(/\r?\n/g)
+		.filter(line => line.trim() !== '@github/copilot/**')
+		.join('\n') + '\n@github/copilot/prebuilds/**\n');
+
 	return es.merge(
 		localExtensionsStream,
 		gulp.src(dependenciesSrc, { base: '.' })
-			.pipe(util2.cleanNodeModules(path.join(root, 'build', '.moduleignore')))
+			.pipe(util2.cleanNodeModules(copilotModuleIgnorePath))
 			.pipe(util2.cleanNodeModules(path.join(root, 'build', `.moduleignore.${process.platform}`)))
 	).pipe(util2.setExecutableBit(['**/*.sh']));
 }
