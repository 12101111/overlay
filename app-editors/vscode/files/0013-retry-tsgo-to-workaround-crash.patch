 build/lib/tsgo.ts | 70 ++++++++++++++++++++++++++---------------------
 1 file changed, 39 insertions(+), 31 deletions(-)

diff --git a/build/lib/tsgo.ts b/build/lib/tsgo.ts
index c218d131c05..5c5c49b5c6f 100644
--- a/build/lib/tsgo.ts
+++ b/build/lib/tsgo.ts
@@ -42,44 +42,52 @@ export function spawnTsgo(projectPath: string, config: { taskName: string; noEmi
 	} else {
 		args.push('--sourceMap', '--inlineSources');
 	}
-	const child = cp.spawn(process.execPath, args, {
-		cwd: root,
-		stdio: ['ignore', 'pipe', 'pipe']
-	});
+	function attempt(retriesLeft: number): Promise<void> {
+		const child = cp.spawn(process.execPath, args, {
+			cwd: root,
+			stdio: ['ignore', 'pipe', 'pipe']
+		});
 
-	let stdoutData = '';
-	let stderrData = '';
+		let stdoutData = '';
+		let stderrData = '';
 
-	child.stdout?.on('data', (data: Buffer) => {
-		stdoutData += data.toString();
-	});
-	child.stderr?.on('data', (data: Buffer) => {
-		stderrData += data.toString();
-	});
+		child.stdout?.on('data', (data: Buffer) => {
+			stdoutData += data.toString();
+		});
+		child.stderr?.on('data', (data: Buffer) => {
+			stderrData += data.toString();
+		});
 
-	return new Promise<void>((resolve, reject) => {
-		child.on('exit', code => {
-			const allOutput = stdoutData + '\n' + stderrData;
-			const lines = allOutput
-				.split(/\r?\n/)
-				.map(line => line.replace(ansiRegex, '').trim())
-				.map(line => line.replace(timestampRegex, ''))
-				.filter(line => line.length > 0)
-				.filter(line => !/Starting compilation|File change detected|Compilation complete/i.test(line));
+		return new Promise<void>((resolve, reject) => {
+			child.on('exit', code => {
+				const allOutput = stdoutData + '\n' + stderrData;
+				const lines = allOutput
+					.split(/\r?\n/)
+					.map(line => line.replace(ansiRegex, '').trim())
+					.map(line => line.replace(timestampRegex, ''))
+					.filter(line => line.length > 0)
+					.filter(line => !/Starting compilation|File change detected|Compilation complete/i.test(line));
 
-			runReporter(lines.join('\n'));
+				runReporter(lines.join('\n'));
 
-			if (code === 0) {
-				Promise.resolve().then(() => onComplete?.()).then(() => resolve(), reject);
-			} else {
-				reject(new Error(`tsgo exited with code ${code ?? 'unknown'}`));
-			}
-		});
+				if (code === 0) {
+					Promise.resolve(onComplete?.()).then(() => resolve(), reject);
+				} else if (retriesLeft > 0) {
+					fancyLog(
+						`tsgo exited with code ${code ?? "unknown"}, retrying... (${retriesLeft} attempts left)`,
+					);
+					attempt(retriesLeft - 1).then(resolve, reject);
+				} else {
+					reject(new Error(`tsgo exited with code ${code ?? 'unknown'}`));
+				}
+			});
 
-		child.on('error', err => {
-			reject(err);
+			child.on('error', err => {
+				reject(err);
+			});
 		});
-	});
+	}
+	return attempt(5);
 }
 
 export function createTsgoStream(projectPath: string, config: { taskName: string; noEmit?: boolean }, onComplete?: () => Promise<void> | void): NodeJS.ReadWriteStream {
