Subject: [PATCH 15/15] Build copilot in offline mode

---
 build/lib/copilot.ts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/build/lib/copilot.ts b/build/lib/copilot.ts
index 7d8ae23f34e..65e8bf97358 100644
--- a/build/lib/copilot.ts
+++ b/build/lib/copilot.ts
@@ -357,6 +357,13 @@ function resolveVersionMatchedCopilotPlatformPackage(copilotPackagePlatformArch:
 		return { dir: appRootDir, cleanup: noop };
 	}
 
+	// Offline builds cannot fetch: the extension's own node_modules already
+	// holds the platform package at exactly the extension-pinned version.
+	const extensionDir = path.join(import.meta.dirname, '..', '..', 'extensions', 'copilot', 'node_modules', '@github', `copilot-${copilotPackagePlatformArch}`);
+	if (readOptionalPackageVersion(extensionDir) === extVersion) {
+		return { dir: extensionDir, cleanup: noop };
+	}
+
 	const integrity = resolvePinnedPlatformPackageIntegrity(packageName, extVersion, options);
 	const staged = fs.mkdtempSync(path.join(os.tmpdir(), 'vscode-copilot-native-'));
 	try {
